# Copy to .env in this directory. compose reads it with
#   docker compose --env-file deployment/.env -f deployment/compose.yaml ...
# There is no secret here: accounts, vaults and device tokens live in the data
# directory, and a device token is shown once, on the website, when it is issued.

# Public hostname of the relay. DNS must resolve to this host and inbound
# TCP 80/443 must reach Caddy, which obtains the certificate for this name.
SYNC_DOMAIN=sync.example.com
# Contact address for certificate expiry notices.
ACME_EMAIL=admin@example.com

# Optional byte limits passed straight to serve. Defaults: 10 GiB per account
# (declared sizes, including unfinished uploads), 1 GiB per package (also the
# server's maximum). Lowering the quota deletes nothing; it refuses new uploads
# with 507 until usage drops.
SYNC_QUOTA_BYTES=10737418240
SYNC_MAX_FILE_BYTES=1073741824
