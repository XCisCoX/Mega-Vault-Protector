# ── Build output ──────────────────────────────────────────────────────────
# CMake binary tree (out/build/vs2022-x64/...)
/out/
/build/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeTmp/
CTestTestfile.cmake
DartConfiguration.tcl
Testing/

# vcpkg installed tree (a local copy; the real one lives outside the repo)
/vcpkg_installed/

# ── Visual Studio ────────────────────────────────────────────────────────
# VS workspace cache / IntelliSense DB
.vs/
.vsconfig
*.user
*.suo
*.VC.db
*.VC.VC.opendb
*.ncb
*.sdf
*.opensdf
*.ipch
x64/
Debug/
Release/
ipch/

