# ── Tests / tooling logs ──────────────────────────────────────────────────
*.log
*.tmp
*.core
core.*

# ── Android (Kotlin/Compose app + NDK builds) ────────────────────────────
# Gradle + AGP caches, build trees, and machine-specific files. The checked-in
# sources live in android/app/src/; everything under android/app/build is
# regenerated by `gradle assembleDebug`.
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/.cxx/
android/app/release/
android/local.properties
android/captures/
*.apk
*.aab
*.keystore
*.jks
*.p12
*.pfx
# The release signing key and its password, if anyone copies the folder in.
# It belongs next to the repository (Desktop/MegaVault/android-signing), never
# inside it.
android-signing/
hs_err_pid*
replay_pid*

# Android dependency build tree (out/android-arm64 — see docs/ANDROID-BUILD.md)
/out/android-arm64/prefix/
/out/android-arm64/src/
/out/android-arm64/*.archive
/out/android-arm64/gradle/
/out/android-arm64/gradle-home/
/out/android-arm64/qt-android/
/out/android-arm64/appbuild/
/out/android-arm64/*.log

cloud/config.json

# Local self-hosted sync data, Python caches and developer environments.
# Sync recovery secrets and device credentials never belong in Git.
/sync-data/
__pycache__/
*.py[cod]
.venv/
CMakeUserPresets.json

# ── Sync relay material ───────────────────────────────────────────────────
# A relay's data directory is a SQLite database plus opaque packages. Point
# --data at the checkout, run the live harness with the wrong scratch dir, or
# export a package by hand and real vault ciphertext lands next to the sources.
/sync_server/data/
sync.sqlite3
sync.sqlite3-wal
sync.sqlite3-shm
*.mvpk
*.mvpk.part

# ── Secrets ───────────────────────────────────────────────────────────────
# Deployment reads these from the environment or the machine, never from Git.
# .env.example stays tracked: it is the documented shape, not a credential.
.env
deployment/.env
*.pem
*.key
