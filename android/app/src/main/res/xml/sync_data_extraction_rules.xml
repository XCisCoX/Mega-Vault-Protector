<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="sync_v3.xml" />
        <!-- Removed protocol 2 state: excluded so it is never carried off-device either. -->
        <exclude domain="sharedpref" path="sync_v2.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync_v3.xml" />
        <exclude domain="sharedpref" path="sync_v2.xml" />
    </device-transfer>
</data-extraction-rules>
