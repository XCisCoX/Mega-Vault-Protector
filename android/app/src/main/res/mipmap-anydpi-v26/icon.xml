<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. The badge sits inside the 66dp safe circle of the
     108dp canvas, so a circular, squircle or rounded-square mask can never crop
     the wordmark; the monochrome layer gives Android 13 themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
